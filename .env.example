# ───── Database (Railway provides this when you add a Postgres plugin) ─────
DATABASE_URL="postgresql://user:password@localhost:5432/barbershop?schema=public"

# ───── Auth.js / NextAuth ─────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed platform (QR codes, links, redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Root marketing domain (used to decide marketing vs. tenant routing if you
# later add subdomains). Path routing (/t/<slug>) works without this.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ───── Email (welcome + booking confirmations). Leave blank to log-only. ─────
# Uses the Resend HTTP API when set; otherwise emails are written to the server log.
RESEND_API_KEY=""
EMAIL_FROM="The Chair <hello@example.com>"

# ───── Stripe billing (self-serve subscriptions) ─────
# Buyers pay on Stripe's hosted Checkout — no card data touches this app.
# Leave blank to run the site with free (Solo) signups only; paid plans then
# route owners to the billing page telling them checkout isn't connected yet.
STRIPE_SECRET_KEY=""                  # sk_test_… (Developers → API keys)
STRIPE_PUBLISHABLE_KEY=""             # pk_test_… (not required for hosted Checkout)
STRIPE_WEBHOOK_SECRET=""              # whsec_… (Developers → Webhooks → signing secret)
# Recurring Price ids — generate these with `npm run stripe:setup`
# (it prints the two lines below for you to paste in).
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_BARBERSHOP=""

# Solo price id (Solo is a paid tier in code; generated by `npm run stripe:setup`).
STRIPE_PRICE_SOLO=""

# Stripe Tax (automatic VAT/sales tax). Off by default. Set to 1 ONLY after
# activating Stripe Tax in the dashboard — it also collects a billing address.
STRIPE_TAX_ENABLED=""

# ───── Seed credentials (used by `npm run db:seed`) ─────
# The Superadmin (internal role PLATFORM_ADMIN) — manages all stores and users.
# Set these locally in .env (never commit real credentials).
PLATFORM_ADMIN_EMAIL="admin@example.com"
# The master superadmin address — immune to in-app demote/deactivate/delete.
# A new owner repoints this to themselves at handoff. Unset = founder default.
MASTER_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD="change-me-before-seeding"    # 10+ chars; seed refuses to run without it
# The destructive reseed (deletes non-demo tenants/users) refuses to run unless:
CONFIRM_SEED=""                       # set to "1" only when you intend a full reset
# Optional hidden dev "superuser" account (cross-tenant). Left unset = not created.
SUPERUSER_PASSWORD=""

# ───── SMS reminders (Twilio) — optional server-wide fallback ─────
# Shops can connect their own Twilio in Settings; these are the fallback used
# when a shop hasn't. Point the number's inbound "A message comes in" webhook at
# POST /api/sms/inbound so STOP/START opt-outs are recorded (TCPA compliance).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                        # E.164, e.g. +15551234567

# ───── Observability & scaling (optional) ─────
# Error tracking (Sentry). SENTRY_DSN = server/edge; the NEXT_PUBLIC_ copy = browser.
# Unset = Sentry is a no-op.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Distributed rate limiting (Upstash Redis REST). When both are set, rate limits
# are shared across replicas + survive deploys; unset = per-instance in-memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───── Operations ─────
# Protects the external /api/cron/reminders trigger. Unset = the route is disabled
# (the in-process 5-min scheduler still runs). Generate: openssl rand -hex 24
CRON_SECRET=""

# ───── Internal integrations (used by the SW Sales portal + fleet tooling) ─────
SALES_API_KEY=""                      # shared key: SW Sales portal ↔ /api/sales/*
# Yggdrasil is the internal developer/fleet-management bridge (/api/yggdrasil/*).
# YGGDRASIL_LINK_SECRET: operator credential. When set, it (a) acts as a master
# bearer AND (b) is REQUIRED to complete the first pairing — this closes the
# trust-on-first-use window so an unpaired instance can't be claimed by whoever
# hits /pair first. Leave unset to keep legacy trust-on-first-use pairing.
YGGDRASIL_LINK_SECRET=""              # 32+ chars; openssl rand -hex 32
# Kill switch. Set to false/0/off to turn the whole bridge off (every
# /api/yggdrasil/* route 404s). Unset/anything else = enabled.
YGGDRASIL_ENABLED=""
