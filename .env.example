# ───── Database (Railway provides this when you add a Postgres plugin) ─────
DATABASE_URL="postgresql://user:password@localhost:5432/barbershop?schema=public"

# ───── Auth.js / NextAuth ─────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed platform (QR codes, links, redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Root marketing domain (used to decide marketing vs. tenant routing if you
# later add subdomains). Path routing (/t/<slug>) works without this.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ───── Email (welcome + booking confirmations). Leave blank to log-only. ─────
# Uses the Resend HTTP API when set; otherwise emails are written to the server log.
RESEND_API_KEY=""
EMAIL_FROM="The Chair <hello@example.com>"

# ───── Seed credentials (used by `npm run db:seed`) ─────
# The Superadmin (internal role PLATFORM_ADMIN) — manages all stores and users.
# Set these locally in .env (never commit real credentials).
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="change-me-before-seeding"
