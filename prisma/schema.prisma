generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  PLATFORM_ADMIN // runs the whole SaaS; tenantId is null
  OWNER // shop owner
  BARBER // staff who takes appointments
  RECEPTIONIST // front desk
  CUSTOMER // end client (self-serve)
  SUPERUSER // hidden dev-team debug role; can open any store's portal. tenantId is null; never a real barber and never public.
}

enum TenantStatus {
  PENDING // provisioned but not yet live
  ACTIVE
  SUSPENDED
}

enum Plan {
  SOLO
  PRO
  ENTERPRISE
}

enum BetaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  X
}

// ───────────────────── Feedback & Development Center ─────────────────────
enum TicketType {
  BUG
  QUESTION
  FEATURE
}

enum TicketStatus {
  NEW
  NEEDS_REVIEW
  APPROVED
  BACKLOG
  READY
  IN_PROGRESS
  CODE_REVIEW
  QA
  READY_FOR_RELEASE
  RELEASED
  CLOSED
  ARCHIVED
}

enum TicketPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  CRITICAL
  BLOCKER
}

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SocialStatus {
  IDEA
  DRAFT
  SCHEDULED
  POSTED
}

// ───────────────────────── Tenancy ─────────────────────────

// A Tenant is one barbershop (or, later, any appointment business).
// Every business record below carries tenantId for hard isolation.
model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique // used in /t/<slug> routing
  name        String
  storeNumber Int          @default(0) // display id (1–999) for the store picker
  // Demo/sample shops (loaded via "Try the demo"). Kept OUT of every live/public
  // surface (store picker, sitemap) so demo and real data never overlap.
  isDemo      Boolean      @default(false)
  status      TenantStatus @default(PENDING)
  plan        Plan         @default(SOLO)

  // Branding
  tagline           String?
  primaryColor      String  @default("#c9a24b") // main accent: buttons, CTAs, prices
  secondaryColor    String  @default("#c9a24b") // accent: headings, highlights, labels
  logoUrl           String?
  heroImageUrl      String?
  // CSS object-position for the hero photo, e.g. "50% 30%". Lets admins pick
  // which part of the photo stays in frame.
  heroImagePosition String  @default("50% 50%")

  // Contact / locale
  email    String?
  phone    String?
  address  String?
  timezone String  @default("America/New_York")

  // Booking config (Admins can customize in the portal)
  slotIntervalMin Int @default(15)

  // Sales target — the monthly revenue goal shown on the Reports dashboard.
  monthlyGoalCents Int @default(0)

  // Social proof
  googleRating      Float?
  googleReviewCount Int? // total Google reviews (aggregate shown on the storefront)

  // ── Website Content (CMS) — drives the public storefront, all owner-editable ──
  description     String? // "About us" / business description
  website         String?
  heroHeadline    String?
  heroSubheading  String?
  heroCtaText     String?
  announcement    String? // dismissible banner across the top of the storefront
  instagramUrl    String?
  facebookUrl     String?
  tiktokUrl       String?
  xUrl            String? // X / Twitter
  youtubeUrl      String?
  metaTitle       String? // SEO overrides (fall back to auto-generated)
  metaDescription String?
  accentColor     String? // optional 3rd brand color
  faviconUrl      String?
  coverImageUrl   String? // OG / social share image
  // Storefront section visibility toggles
  showBarbers     Boolean @default(true)
  showGallery     Boolean @default(true)
  showReviews     Boolean @default(true)
  showFaq         Boolean @default(true)

  // Feature flags (Phase 5 admin toggles)
  featureSocial    Boolean @default(true)
  featureAnalytics Boolean @default(true)

  users            User[]
  services         Service[]
  clients          Client[]
  appointments     Appointment[]
  workingHours     WorkingHour[]
  socialPosts      SocialPost[]
  galleryItems     GalleryItem[]
  reviews          Review[]
  auditLogs        AuditLog[]
  timeEntries      TimeEntry[]
  timeEditRequests TimeEditRequest[]
  tickets          Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role    @default(BARBER)
  active       Boolean @default(true)

  // Per-user permission overrides layered on top of role defaults.
  // Shape: { "shop.settings": true, "shop.viewAll": false }. Absent key = use role default.
  permissionOverrides Json?

  // When true, this account is locked to the self-check-in kiosk (/kiosk) and
  // cannot reach the full staff portal. Used for shared front-desk tablets.
  kioskOnly Boolean @default(false)

  // null for PLATFORM_ADMIN; set for everyone else
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String?

  // Barber profile fields (used when role = BARBER)
  bio             String?
  avatarUrl       String?
  instagramHandle String?
  // Barber social links (shown on their public storefront profile).
  facebookUrl     String?
  tiktokUrl       String?
  xUrl            String?
  youtubeUrl      String?

  // HR fields — set by admins, read-only to the user themselves
  hireDate    DateTime?
  dateOfBirth DateTime?

  barberAppointments Appointment[]     @relation("BarberAppointments")
  services           Service[]
  workingHours       WorkingHour[]
  socialPosts        SocialPost[]
  auditLogs          AuditLog[]
  timeEntries        TimeEntry[]
  timeEditRequests   TimeEditRequest[]
  reportedTickets    Ticket[]          @relation("TicketReporter")
  assignedTickets    Ticket[]          @relation("TicketAssignee")
  ticketComments     TicketComment[]
  ticketActivity     TicketActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, role])
}

// ───────────────────────── Catalog ─────────────────────────

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  durationMin Int     @default(30)
  priceCents  Int     @default(0)
  imageUrl    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  // Optional: tie a service to a specific barber
  barber   User?   @relation(fields: [barberId], references: [id], onDelete: SetNull)
  barberId String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

model Client {
  id        String  @id @default(cuid())
  name      String // display name — kept in sync with "firstName lastName"
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  address   String?
  notes     String?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Appointment {
  id           String            @id @default(cuid())
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(CONFIRMED)
  notes        String?
  // Preset reason captured when staff reschedule / cancel / mark no-show.
  statusReason String?
  // Soft-delete: appointments are never hard-removed, so the history (e.g. a
  // no-show) is always on record. `false` = removed from active views.
  active       Boolean           @default(true)

  // When the client physically arrived and is waiting (before the cut starts).
  checkedInAt DateTime?
  // Turnaround clock: when the barber started/finished the cut. Duration is
  // finishedAt - startedAt (5-minute minimum for staff; admins can correct).
  startedAt   DateTime?
  finishedAt  DateTime?

  // What the barber actually collected (service amount, excludes tip).
  collectedCents Int?
  tipCents       Int? // tip on top of the service
  paymentMethod  String? // Card | Cash | Digital wallet | Other
  // How the visit happened + how the client found the shop (walk-in logging).
  kind           String  @default("APPOINTMENT") // APPOINTMENT | WALKIN
  referral       String?

  // public token for the customer reschedule / cancel link
  manageToken String @unique @default(cuid())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  barber    User    @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: Cascade)
  barberId  String
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startTime])
  @@index([barberId, startTime])
}

// Weekly recurring availability per barber. dayOfWeek 0=Sun .. 6=Sat
model WorkingHour {
  id        String @id @default(cuid())
  dayOfWeek Int
  startMin  Int // minutes from midnight, 540 = 9:00am
  endMin    Int

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  barber   User   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barberId String

  @@unique([barberId, dayOfWeek])
  @@index([tenantId])
}

// Staff time clock: one row per shift. clockOut = null means still on the clock.
model TimeEntry {
  id       String    @id @default(cuid())
  clockIn  DateTime  @default(now())
  clockOut DateTime?
  note     String?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  editRequests TimeEditRequest[]

  createdAt DateTime @default(now())

  @@index([tenantId, clockIn])
  @@index([userId, clockIn])
}

// A barber's suggested correction to one of their time entries. Admins approve
// or reject it from the notifications bell.
model TimeEditRequest {
  id               String    @id @default(cuid())
  proposedClockIn  DateTime?
  proposedClockOut DateTime?
  reason           String?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  resolvedAt       DateTime?
  resolvedById     String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  entry    TimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId  String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([userId])
}

// ───────────────────────── Tenant site content ─────────────────────────

model GalleryItem {
  id        String  @id @default(cuid())
  imageUrl  String
  caption   String?
  sortOrder Int     @default(0)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Review {
  id         String  @id @default(cuid())
  authorName String
  rating     Int     @default(5)
  body       String
  published  Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdAt DateTime @default(now())

  @@index([tenantId, published])
}

// Social media PLANNING (no live posting in this phase).
model SocialPost {
  id           String           @id @default(cuid())
  caption      String
  imageUrl     String?
  platforms    SocialPlatform[]
  status       SocialStatus     @default(IDEA)
  scheduledFor DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  barber   User   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barberId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

// ───────────────────────── Platform ─────────────────────────

model BetaApplication {
  id           String     @id @default(cuid())
  businessName String
  ownerName    String
  email        String
  phone        String?
  message      String?
  status       BetaStatus @default(PENDING)

  // set once provisioned
  provisionedTenantId String?
  reviewedAt          DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

// Security: audit trail of sensitive actions.
model AuditLog {
  id     String  @id @default(cuid())
  action String
  target String?
  meta   Json?

  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId   String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Privacy-first web analytics (Plausible-style): cookieless, no IPs stored.
// A visitor is a daily-salted hash, so the same person can't be tracked across
// days. Rows are aggregate-only — no names, emails, or personal data.
model PageView {
  id          String  @id @default(cuid())
  tenantId    String? // which shop's public site (null = marketing pages)
  path        String // requested path, e.g. /t/king-cuts/book
  page        String // normalized page type: home|services|book|reviews|...
  source      String // referrer bucket: direct|google|instagram|facebook|...
  device      String // mobile|tablet|desktop
  visitorHash String // anonymous, daily-rotating visitor id (no IP/PII)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([visitorHash])
}

// ───────────────────── Feedback & Development Center ─────────────────────
// Unified ticket: bug reports, questions, and feature requests all live here
// and flow through the Development Center pipeline.
model Ticket {
  id       String          @id @default(cuid())
  ref      String          @unique // human reference, e.g. CHR-1042
  type     TicketType
  status   TicketStatus    @default(NEW)
  priority TicketPriority  @default(MEDIUM)
  severity TicketSeverity? // bugs only

  title       String
  description String
  // Type-specific structured fields (steps, expected, actual, problem,
  // solution, benefit, useCase, category, subject, …). Kept as JSON so each
  // ticket type can carry its own shape without column sprawl.
  details     Json?

  labels String[] @default([])

  // Auto-captured client context (bug reports especially).
  route       String?
  browser     String?
  os          String?
  screen      String?
  appVersion  String?
  consoleLogs String? // buffered JS errors / stack traces (no PII)

  dueDate     DateTime?
  estimateMin Int?
  actualMin   Int?

  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId   String?
  reporter   User    @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  comments    TicketComment[]
  attachments TicketAttachment[]
  activity    TicketActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([status, priority])
}

model TicketComment {
  id       String  @id @default(cuid())
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  body     String
  internal Boolean @default(false) // internal dev note vs public response

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id       String @id @default(cuid())
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  name     String
  mime     String
  dataUrl  String // base64 data URL, size-capped at submit time

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketActivity {
  id       String  @id @default(cuid())
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId  String?
  kind     String // created | status | assign | priority | severity | label | comment
  detail   String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ───────────────────── Yggdrasil Link (fleet management) ─────────────────────
// Single-row pairing record for the Yggdrasil management plane. Stores ONLY the
// sha256 hash of the pairing token — never the token itself.
model YggdrasilLink {
  id        Int      @id @default(1)
  tokenHash String
  origin    String?
  pairedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("yggdrasil_link")
}
